# ═══ Upstash Redis ═══
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# ═══ Admin ═══
ADMIN_TOKEN=your_admin_token

# ═══ Firebase Admin (من ~/firebase-admin.json) ═══
FIREBASE_PROJECT_ID=camera-parent
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@camera-parent.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ═══ Setup & security ═══
# سر الإعداد الأول: مطلوب لـ /admin/claim (أرسله في الهيدر x-setup-secret). ولّد قيمة طويلة عشوائية.
SETUP_SECRET=replace_with_long_random_string
# نطاقات الويب المسموح لها بالـ CORS، مفصولة بفاصلة. في الإنتاج لا تتركها فارغة.
ALLOWED_ORIGINS=https://your-web-app.example.com
